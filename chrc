CHRC_HOME="${CHRC_HOME:-$HOME/.chrc}"
CHRC_VERSION="0.3.0"

_chrc_usage() {
  cat <<'EOF'
chrc (change runcom) - switch shell runcom snippets quickly

Usage:
  chrc <identifier>        Source ~/.chrc/<identifier>.sh in the current shell
  chrc use <identifier>    Same as chrc <identifier>
  chrc new <identifier>    Create a new runcom template (with optional description)
  chrc default <identifier> Set a profile to load when chrc starts
  chrc list                List runcom profiles as ID, desc, file-loc
  chrc cp <source> <dest>   Copy a profile
  chrc edit <identifier>   Open profile in $EDITOR
  chrc show <identifier>   Print profile content
  chrc path <identifier>   Print profile file path
  chrc rm <identifier>     Remove profile after confirmation
  chrc help                Show this help
  chrc version             Show version
EOF
}

_chrc_err() {
  printf 'chrc: %s\n' "$*" >&2
}

_chrc_ensure_home() {
  mkdir -p "$CHRC_HOME"
}

_chrc_valid_identifier() {
  case "${1:-}" in
    ""|*[!A-Za-z0-9._-]*) return 1 ;;
    *) return 0 ;;
  esac
}

_chrc_require_identifier() {
  if ! _chrc_valid_identifier "${1:-}"; then
    if [ -z "${1:-}" ]; then
      _chrc_err "missing identifier"
    else
      _chrc_err "invalid identifier: $1"
      _chrc_err "use only letters, numbers, dots, underscores, and hyphens"
    fi
    return 2
  fi
}

_chrc_profile_path() {
  printf '%s/%s.sh\n' "$CHRC_HOME" "$1"
}

_chrc_require_profile() {
  _chrc_require_identifier "$1" || return $?
  local file
  file="$(_chrc_profile_path "$1")"
  if [ ! -f "$file" ]; then
    _chrc_err "profile not found: $1 ($file)"
    return 1
  fi
  printf '%s\n' "$file"
}

_chrc_read_desc() {
  local file="$1"
  local line
  line="$(grep -m 1 -E '^#[[:space:]]*desc([[:space:]]+|$)' "$file" 2>/dev/null)" || true
  line="${line#\#}"
  line="${line#desc}"
  line="${line# }"
  printf '%s\n' "$line"
}

_chrc_use() {
  local file previous_skip chrc_status
  file="$(_chrc_require_profile "$1")" || return $?
  previous_skip="${CHRC_SKIP_DEFAULT:-}"
  CHRC_SKIP_DEFAULT=1
  . "$file"
  chrc_status=$?
  CHRC_SKIP_DEFAULT="$previous_skip"
  return $chrc_status
}

_chrc_new() {
  _chrc_require_identifier "${1:-}" || return $?
  _chrc_ensure_home
  local file desc
  file="$(_chrc_profile_path "$1")"
  desc="${2:-Describe this runcom profile here.}"
  if [ -e "$file" ]; then
    _chrc_err "profile already exists: $file"
    return 1
  fi
  cat > "$file" <<EOF
#desc $desc

# Add shell configuration below.
# Examples:
# export PATH="\$HOME/bin:\$PATH"
# export EDITOR="vim"
# alias ll='ls -la'

EOF
  printf 'created %s\n' "$file"
}

_chrc_list() {
  _chrc_ensure_home
  printf '%-24s  %-40s  %s\n' "ID" "desc" "file-loc"
  printf '%-24s  %-40s  %s\n' "--" "----" "--------"

  local found=0
  local file id desc
  for file in "$CHRC_HOME"/*.sh; do
    [ -e "$file" ] || continue
    found=1
    id="${file##*/}"
    id="${id%.sh}"
    desc="$(_chrc_read_desc "$file")"
    [ -n "$desc" ] || desc="-"
    printf '%-24s  %-40s  %s\n' "$id" "$desc" "$file"
  done

  if [ "$found" -eq 0 ]; then
    printf '(no profiles found in %s)\n' "$CHRC_HOME"
  fi
}

_chrc_cp() {
  _chrc_require_identifier "$1" || return $?
  _chrc_require_identifier "$2" || return $?
  local src_file dst_file
  src_file="$(_chrc_require_profile "$1")" || return $?
  dst_file="$(_chrc_profile_path "$2")"
  if [ -e "$dst_file" ]; then
    _chrc_err "profile already exists: $dst_file"
    return 1
  fi
  cp "$src_file" "$dst_file"
  printf '%s -> %s\n' "$src_file" "$dst_file"
}

_chrc_edit() {
  local file editor
  file="$(_chrc_require_profile "$1")" || return $?
  editor="${EDITOR:-vi}"
  "$editor" "$file"
}

_chrc_show() {
  local file
  file="$(_chrc_require_profile "$1")" || return $?
  cat "$file"
}

_chrc_path() {
  local file
  file="$(_chrc_require_profile "$1")" || return $?
  printf '%s\n' "$file"
}

_chrc_rm() {
  local file answer
  file="$(_chrc_require_profile "$1")" || return $?
  printf 'Remove %s? [y/N] ' "$file" >&2
  read -r answer
  case "$answer" in
    y|Y|yes|YES) rm "$file" && printf 'removed %s\n' "$file" ;;
    *) printf 'not removed\n' ;;
  esac
}

_chrc_default() {
  local file
  file="$(_chrc_require_profile "$1")" || return $?
  _chrc_ensure_home
  printf '%s\n' "$1" > "$CHRC_HOME/.default"
  printf 'default profile set to %s (%s)\n' "$1" "$file"
}

_chrc_load_default() {
  [ -z "${CHRC_SKIP_DEFAULT:-}" ] || return 0
  [ -z "${CHRC_LOADING_DEFAULT:-}" ] || return 0
  [ -f "$CHRC_HOME/.default" ] || return 0
  local identifier
  IFS= read -r identifier < "$CHRC_HOME/.default"
  _chrc_require_identifier "$identifier" || return $?
  CHRC_LOADING_DEFAULT=1 _chrc_use "$identifier"
}

chrc() {
  local command="${1:-help}"
  case "$command" in
    help|-h|--help) _chrc_usage ;;
    version|-v|--version) printf 'chrc %s\n' "$CHRC_VERSION" ;;
    new) shift; _chrc_new "$@" ;;
    default) shift; _chrc_default "${1:-}" ;;
    list|ls) _chrc_list ;;
    cp|copy) shift; _chrc_cp "$@" ;;
    edit) shift; _chrc_edit "${1:-}" ;;
    show) shift; _chrc_show "${1:-}" ;;
    path) shift; _chrc_path "${1:-}" ;;
    rm|remove) shift; _chrc_rm "${1:-}" ;;
    use) shift; _chrc_use "${1:-}" ;;
    *) _chrc_use "$command" ;;
  esac
}

_chrc_is_sourced() {
  case "${ZSH_EVAL_CONTEXT:-}" in
    *:file*) return 0 ;;
  esac
  if [ -n "${BASH_VERSION:-}" ] && [ "${BASH_SOURCE[0]}" != "$0" ]; then
    return 0
  fi
  return 1
}

if _chrc_is_sourced; then
  _chrc_load_default
else
  _chrc_usage
  printf '\nInstall by sourcing this file from your shell startup file, for example:\n'
  printf '  export CHRC_HOME="$HOME/.chrc"\n'
  printf '  [ -s "$HOME/.chrc/chrc" ] && . "$HOME/.chrc/chrc"\n'
fi
